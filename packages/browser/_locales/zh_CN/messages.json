{
  "builtinTitle": {
    "message": "Chrome 内置翻译器",
    "description": "Translation engine name."
  },
  "fabTranslate": {
    "message": "翻译",
    "description": "Floating button."
  },
  "fabDownloadModel": {
    "message": "下载翻译模型",
    "description": "Floating button."
  },
  "fabDownloading": {
    "message": "正在下载模型 $PERCENT$%",
    "description": "Floating button while a model downloads.",
    "placeholders": {
      "percent": {
        "content": "$1"
      }
    }
  },
  "fabTranslating": {
    "message": "正在翻译…（$COUNT$）",
    "description": "Floating button; COUNT is the number of pending items.",
    "placeholders": {
      "count": {
        "content": "$1"
      }
    }
  },
  "fabTooltip": {
    "message": "翻译为$LANGUAGE$ · $ENGINE$",
    "description": "Floating button tooltip.",
    "placeholders": {
      "language": {
        "content": "$1"
      },
      "engine": {
        "content": "$2"
      }
    }
  },
  "labelTranslating": {
    "message": "正在翻译…",
    "description": "Label above a comment."
  },
  "labelNeedsModel": {
    "message": "需要下载翻译模型",
    "description": "Label above a comment."
  },
  "labelTranslated": {
    "message": "已翻译：$FROM$ → $TO$",
    "description": "Label above a translated comment.",
    "placeholders": {
      "from": {
        "content": "$1"
      },
      "to": {
        "content": "$2"
      }
    }
