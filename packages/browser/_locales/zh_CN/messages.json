  "labelOriginal": {
    "message": "原文（$LANGUAGE$）",
    "description": "Label above a comment shown in the original.",
    "placeholders": {
      "language": {
        "content": "$1"
      }
    }
  },
  "labelError": {
    "message": "翻译失败：$ERROR$",
    "description": "Label above a comment.",
    "placeholders": {
      "error": {
        "content": "$1"
      }
    }
  },
  "labelDownloadFailed": {
    "message": "无法下载模型：$ERROR$",
    "description": "Label above a comment.",
    "placeholders": {
      "error": {
        "content": "$1"
      }
    }
  },
  "tooltipOriginal": {
    "message": "原文（$LANGUAGE$）：\n$TEXT$",
    "description": "Tooltip of a translated title.",
    "placeholders": {
      "language": {
        "content": "$1"
      },
      "text": {
        "content": "$2"
      }
    }
  },
  "tooltipError": {
    "message": "翻译失败：$ERROR$",
    "description": "Tooltip of a title that failed to translate.",
    "placeholders": {
      "error": {
        "content": "$1"
      }
    }
  },
  "sourceUnknown": {
    "message": "原文",
    "description": "Stands for the source language when it is unknown."
  },
  "actionDownload": {
    "message": "下载",
    "description": "Link in a label."
  },
  "actionRetry": {
    "message": "重试",
    "description": "Link in a label."
  },
  "actionShowTranslation": {
    "message": "显示译文",
    "description": "Link in a label and floating button."
  },
  "actionShowOriginal": {
    "message": "显示原文",
    "description": "Link in a label and floating button."
  },
  "errorUnsupported": {
    "message": "此浏览器无法使用 Chrome 内置翻译器：需要桌面版 Chrome 138 或更高版本",
    "description": "Error text after \"Translation failed:\"."
