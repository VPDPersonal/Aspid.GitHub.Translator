  "actionRetry": {
    "message": "Reintentar",
    "description": "Link in a label."
  },
  "actionShowTranslation": {
    "message": "Mostrar traducción",
    "description": "Link in a label and floating button."
  },
  "actionShowOriginal": {
    "message": "Mostrar original",
    "description": "Link in a label and floating button."
  },
  "errorUnsupported": {
    "message": "el traductor integrado de Chrome no está disponible en este navegador: necesita Chrome 138 o posterior para ordenador",
    "description": "Error text after \"Translation failed:\"."
