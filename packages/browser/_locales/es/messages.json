{
  "builtinTitle": {
    "message": "Traductor integrado de Chrome",
    "description": "Translation engine name."
  },
  "fabTranslate": {
    "message": "Traducir",
    "description": "Floating button."
  },
  "fabDownloadModel": {
    "message": "Descargar modelo de traducción",
    "description": "Floating button."
  },
  "fabDownloading": {
    "message": "Descargando modelo: $PERCENT$ %",
    "description": "Floating button while a model downloads.",
    "placeholders": {
      "percent": {
        "content": "$1"
      }
    }
  },
  "fabTranslating": {
    "message": "Traduciendo… ($COUNT$)",
    "description": "Floating button; COUNT is the number of pending items.",
    "placeholders": {
      "count": {
        "content": "$1"
      }
    }
  },
  "fabTooltip": {
    "message": "Traducción al $LANGUAGE$ · $ENGINE$",
    "description": "Floating button tooltip.",
    "placeholders": {
      "language": {
        "content": "$1"
      },
      "engine": {
        "content": "$2"
      }
    }
  },
  "labelTranslating": {
    "message": "Traduciendo…",
    "description": "Label above a comment."
  },
  "labelNeedsModel": {
    "message": "Hay que descargar un modelo de traducción",
    "description": "Label above a comment."
  },
  "labelTranslated": {
    "message": "Traducido: $FROM$ → $TO$",
    "description": "Label above a translated comment.",
    "placeholders": {
