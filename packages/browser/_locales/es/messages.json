  "labelOriginal": {
    "message": "Original ($LANGUAGE$)",
    "description": "Label above a comment shown in the original.",
    "placeholders": {
      "language": {
        "content": "$1"
      }
    }
  },
  "labelError": {
    "message": "Error de traducción: $ERROR$",
    "description": "Label above a comment.",
    "placeholders": {
      "error": {
        "content": "$1"
      }
    }
  },
  "labelDownloadFailed": {
    "message": "No se pudo descargar el modelo: $ERROR$",
    "description": "Label above a comment.",
    "placeholders": {
      "error": {
        "content": "$1"
      }
    }
  },
  "tooltipOriginal": {
    "message": "Original ($LANGUAGE$):\n$TEXT$",
    "description": "Tooltip of a translated title.",
    "placeholders": {
      "language": {
        "content": "$1"
      },
      "text": {
        "content": "$2"
      }
    }
  },
  "tooltipError": {
    "message": "Error de traducción: $ERROR$",
    "description": "Tooltip of a title that failed to translate.",
    "placeholders": {
      "error": {
        "content": "$1"
      }
    }
