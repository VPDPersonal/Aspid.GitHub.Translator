{
  "name": "asp-github-translator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aspid Translator for GitHub: Chrome extension that translates pull requests, commits and READMEs on GitHub.",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "zip": "node build.mjs --zip",
    "store:promo": "node store/render.mjs promo",
    "store:shots": "npm run build && node store/render.mjs shots"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "puppeteer-core": "^24.43.1"
  }
}
